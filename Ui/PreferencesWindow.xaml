<Window x:Class="ImportCanonPhotos.Ui.PreferencesWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Canon Photos - Preferences"
        Height="430" Width="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,10,8,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button" x:Key="BrowseButton">
            <Setter Property="Width" Value="86"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Camera -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Camera DCIM folder"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}"
                        Content="Browse..." Click="BrowseCamera_Click"/>
                <TextBox x:Name="CameraFolderBox" Height="24" VerticalContentAlignment="Center"
                         ToolTip="Every subfolder of this DCIM folder is imported, so 101CANON onwards are picked up too."/>
            </DockPanel>
        </StackPanel>

        <!-- Dropbox -->
        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Dropbox Camera Uploads folder"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}"
                        Content="Browse..." Click="BrowseDropbox_Click"/>
                <TextBox x:Name="DropboxFolderBox" Height="24" VerticalContentAlignment="Center"
                         ToolTip="Environment variables such as %USERPROFILE% are expanded."/>
            </DockPanel>
        </StackPanel>

        <!-- Output -->
        <StackPanel Grid.Row="2">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}"
                        Content="Browse..." Click="BrowseOutput_Click"/>
                <TextBox x:Name="OutputFolderBox" Height="24" VerticalContentAlignment="Center"
                         ToolTip="Files are filed as &lt;output&gt;\year\Month\yyyy-MM-dd\&lt;type&gt;. Environment variables are expanded."/>
            </DockPanel>
        </StackPanel>

        <!-- DNG Converter -->
        <StackPanel Grid.Row="3">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Adobe DNG Converter"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BrowseButton}"
                        Content="Browse..." Click="BrowseConverter_Click"/>
                <TextBox x:Name="ConverterPathBox" Height="24" VerticalContentAlignment="Center"
                         ToolTip="Used to convert CR3 raw files to DNG."/>
            </DockPanel>
        </StackPanel>

        <!-- Toggles -->
        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <CheckBox x:Name="LosslessCheck" Margin="0,0,0,8"
                      Content="Also import CR3 as lossless DNG (second pass into a dng-lossless folder)"/>
            <CheckBox x:Name="ReEncodeCheck" Margin="0,0,0,8"
                      Content="Re-encode MP4 videos into a re-encoded-mp4 folder (keeps the original)"/>
            <CheckBox x:Name="OverwriteCheck" Margin="0,0,0,8"
                      Content="Overwrite files that already exist at the destination (otherwise skip them)"/>
            <CheckBox x:Name="DeleteSourceCheck"
                      Content="Delete imported files from the card / Dropbox afterwards (permanent, no recycle bin)"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,14,0,0"
                   TextWrapping="Wrap" Foreground="#B00" Text=""/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Restore Defaults" Width="120" Height="26" Margin="0,0,8,0" Click="RestoreDefaults_Click"/>
            <!-- IsCancel sets DialogResult=false and closes; adding a Click handler that
                 also assigns DialogResult would throw on the already-closed window. -->
            <Button Content="Cancel" Width="90" Height="26" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="90" Height="26" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
