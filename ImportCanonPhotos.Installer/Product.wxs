<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define ProductVersion="1.0.0.0" ?>
  <?define ProductName="Import Canon Photos" ?>
  <?define Manufacturer="Ben Staniford" ?>
  <?define UpgradeCode="8EF7BD3C-2B64-4C37-8CD1-048B0E844276" ?>

  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="$(var.ProductName) Installer"
             Comments="Imports photos from a Canon camera or Dropbox into a dated library" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Installation directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ImportCanonPhotos">
          <Directory Id="IconsFolder" Name="icons" />
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Import Canon Photos"/>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Components -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ImportCanonPhotosExe" Guid="{DA1B2C3D-4E5F-6A7B-8C9D-0E1F2A3B4C5D}">
        <File Id="ImportCanonPhotosEXE"
              Source="$(var.ImportCanonPhotos.TargetDir)ImportCanonPhotos.exe"
              KeyPath="yes"
              Checksum="yes" />
        <File Id="ImportCanonPhotosDLL"
              Source="$(var.ImportCanonPhotos.TargetDir)ImportCanonPhotos.dll" />
        <File Id="ImportCanonPhotosRuntimeConfigJson"
              Source="$(var.ImportCanonPhotos.TargetDir)ImportCanonPhotos.runtimeconfig.json" />
        <File Id="ImportCanonPhotosDepsJsonFile"
              Source="$(var.ImportCanonPhotos.TargetDir)ImportCanonPhotos.deps.json" />
      </Component>

      <!-- NuGet Dependencies - H.NotifyIcon -->
      <Component Id="HNotifyIcon" Guid="{EB2C3D4E-5F6A-7B8C-9D0E-1F2A3B4C5D6E}">
        <File Id="HNotifyIconWpfDll"
              Source="$(var.ImportCanonPhotos.TargetDir)H.NotifyIcon.Wpf.dll"
              KeyPath="yes" />
      </Component>

      <Component Id="HNotifyIconCore" Guid="{FC3D4E5F-6A7B-8C9D-0E1F-2A3B4C5D6E7F}">
        <File Id="HNotifyIconDll"
              Source="$(var.ImportCanonPhotos.TargetDir)H.NotifyIcon.dll"
              KeyPath="yes" />
      </Component>

      <!-- Transitive dependency of H.NotifyIcon.Wpf -->
      <Component Id="HGeneratedIcons" Guid="{9D87FE08-B209-4815-BFF9-331B538EFA72}">
        <File Id="HGeneratedIconsDll"
              Source="$(var.ImportCanonPhotos.TargetDir)H.GeneratedIcons.System.Drawing.dll"
              KeyPath="yes" />
      </Component>

      <!-- NuGet Dependencies - MetadataExtractor (EXIF date reading) -->
      <Component Id="MetadataExtractor" Guid="{AF35D91A-E233-4DD1-8DAB-60178F4351D6}">
        <File Id="MetadataExtractorDll"
              Source="$(var.ImportCanonPhotos.TargetDir)MetadataExtractor.dll"
              KeyPath="yes" />
      </Component>

      <!-- Transitive dependency of MetadataExtractor -->
      <Component Id="XmpCore" Guid="{5A350B40-C4C8-4BAC-A2F2-DF28E53E3D82}">
        <File Id="XmpCoreDll"
              Source="$(var.ImportCanonPhotos.TargetDir)XmpCore.dll"
              KeyPath="yes" />
      </Component>

      <!-- NuGet Dependencies - NReco.VideoConverter (ffmpeg.exe is embedded in this DLL) -->
      <Component Id="NRecoVideoConverter" Guid="{1171F653-51DB-4B50-B801-5BEB2B357F1B}">
        <File Id="NRecoVideoConverterDll"
              Source="$(var.ImportCanonPhotos.TargetDir)NReco.VideoConverter.dll"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Icons folder component -->
    <DirectoryRef Id="IconsFolder">
      <Component Id="IconsComponent" Guid="{AD0E1F2A-3B4C-5D6E-7F8A-9B0C1D2E3F4A}">
        <File Id="AppIco"
              Source="$(var.ImportCanonPhotos.TargetDir)icons\app.ico"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu Shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="{BE1F2A3B-4C5D-6E7F-8A9B-0C1D2E3F4A5B}">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Import Canon Photos"
                  Description="Imports photos from a Canon camera or Dropbox into a dated library"
                  Target="[INSTALLFOLDER]ImportCanonPhotos.exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\ImportCanonPhotos"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Desktop Shortcut (Optional) -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{CF2A3B4C-5D6E-7F8A-9B0C-1D2E3F4A5B6C}">
        <Shortcut Id="DesktopShortcut"
                  Name="Import Canon Photos"
                  Description="Imports photos from a Canon camera or Dropbox into a dated library"
                  Target="[INSTALLFOLDER]ImportCanonPhotos.exe"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="CleanUpDesktopShortcut" Directory="DesktopFolder" On="uninstall"/>
        <RegistryValue Root="HKCU"
                       Key="Software\ImportCanonPhotos"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Registry entry for Run at startup -->
    <DirectoryRef Id="TARGETDIR">
      <Component Id="RegistryEntries" Guid="{D03B4C5D-6E7F-8A9B-0C1D-2E3F4A5B6C7D}">
        <RegistryKey Root="HKCU" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run">
          <RegistryValue Name="ImportCanonPhotos" Value="[INSTALLFOLDER]ImportCanonPhotos.exe" Type="string" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <!-- Features -->
    <Feature Id="ProductFeature" Title="Import Canon Photos" Level="1">
      <ComponentRef Id="ImportCanonPhotosExe" />
      <ComponentRef Id="IconsComponent" />
      <ComponentRef Id="HNotifyIcon" />
      <ComponentRef Id="HNotifyIconCore" />
      <ComponentRef Id="HGeneratedIcons" />
      <ComponentRef Id="MetadataExtractor" />
      <ComponentRef Id="XmpCore" />
      <ComponentRef Id="NRecoVideoConverter" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Desktop Shortcut" Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Auto-start with Windows -->
    <Feature Id="AutoStartFeature" Title="Start with Windows" Level="1">
      <ComponentRef Id="RegistryEntries" />
    </Feature>

    <!-- Custom Action to launch app after installation -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Import Canon Photos" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#ImportCanonPhotosEXE]" />

    <CustomAction Id="LaunchApplication"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Custom>
    </InstallExecuteSequence>

    <!-- UI -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- License -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Icons -->
    <Icon Id="app.ico" SourceFile="$(var.ImportCanonPhotos.TargetDir)icons\app.ico"/>
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
  </Product>
</Wix>
